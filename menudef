// Tuning a recogniser is done by feel, in the headset, where there is no
// keyboard -- so every dial that decides whether a gesture fires is here
// rather than console-only.

OptionMenu "RSGMain"
{
	Title "Gestures"
	StaticText "A shape drawn in the air, matched against", "gray"
	StaticText "templates by dynamic time warping -- so the", "gray"
	StaticText "same shape performed faster or slower still", "gray"
	StaticText "matches.", "gray"
	StaticText ""
	Option "Enabled", "rsg_enabled", "OnOff"
	Option "Debug printing", "rsg_debug", "OnOff"
	StaticText ""
	StaticText "Raise your OFF hand above your head and hold it", "gold"
	StaticText "there -- mode opens, then draw with your other", "gold"
	StaticText "hand. Drop the raised hand to fire the shape.", "gold"
	StaticText ""
	Submenu "Entry and exit", "RSGEntry"
	Submenu "Matching", "RSGMatch"
	Submenu "Record your own", "RSGRecord"
}

OptionMenu "RSGRecord"
{
	Title "Record your own"
	StaticText "Pick a slot, close the menu, then perform the", "gray"
	StaticText "shape at least three times: raise your off", "gray"
	StaticText "hand, draw, drop it. Come back and save.", "gray"
	StaticText ""
	StaticText "Your most typical take becomes the gesture,", "gray"
	StaticText "and how much your takes varied sets how", "gray"
	StaticText "forgiving it is -- no slider needed.", "gray"
	StaticText ""
	Command "Record slot 1", "netevent rsg_rec_start 1"
	Command "Record slot 2", "netevent rsg_rec_start 2"
	Command "Record slot 3", "netevent rsg_rec_start 3"
	Command "Record slot 4", "netevent rsg_rec_start 4"
	StaticText ""
	Command "Save recording", "netevent rsg_rec_save"
	Command "Cancel recording", "netevent rsg_rec_cancel"
	StaticText ""
	SafeCommand "Clear slot 1", "netevent rsg_rec_clear 1"
	SafeCommand "Clear slot 2", "netevent rsg_rec_clear 2"
	SafeCommand "Clear slot 3", "netevent rsg_rec_clear 3"
	SafeCommand "Clear slot 4", "netevent rsg_rec_clear 4"
	StaticText ""
	StaticText "Saved gestures match as custom_1 to custom_4.", "gold"
}

OptionMenu "RSGEntry"
{
	Title "Entry and exit"
	StaticText "Gesture mode is entered deliberately, or every", "gray"
	StaticText "arm movement in a fight is a candidate gesture.", "gray"
	StaticText ""
	Slider "Hold to enter (tics)", "rsg_entry_hold", 5, 70, 1, 0
	StaticText "35 tics = 1 second.", "gold"
	StaticText ""
	Slider "Close after idle (tics)", "rsg_idle_exit", 70, 1050, 35, 0
	StaticText "Mode also closes when you take damage.", "gray"
}

OptionMenu "RSGMatch"
{
	Title "Matching"
	Slider "Max stroke length (tics)", "rsg_window", 10, 105, 5, 0
	StaticText "Hold the off hand raised through the sweep, drop", "gray"
	StaticText "it to match -- this only caps how long one hold", "gray"
	StaticText "may run.", "gray"
	StaticText ""
	Slider "Tolerance (map units)", "rsg_tolerance", 2, 60, 1, 0
	StaticText "Turn this UP when a gesture you are drawing", "gold"
	StaticText "correctly refuses to fire.", "gold"
	StaticText ""
	Slider "Confidence needed", "rsg_confidence", 0.0, 1.0, 0.05, 2
	StaticText "Turn this UP when unrelated arm movement is", "gold"
	StaticText "firing gestures.", "gold"
	StaticText ""
	Slider "Minimum stroke size", "rsg_min_extent", 0, 40, 1, 0
	StaticText "A hand holding still draws a tiny tight path", "gray"
	StaticText "that would otherwise match almost anything.", "gray"
}

AddOptionMenu "OptionsMenu"
{
	Submenu "Gestures", "RSGMain"
}
