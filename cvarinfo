// RS_GESTURES -- CVars
//
// A gesture is a shape drawn in the air, matched against recorded templates by
// dynamic time warping so the same shape performed faster or slower still
// matches. Nothing here rewrites engine state; it reads the hand and head pose
// the engine already publishes every tic and decides whether the last second of
// motion looks like a template.
//
// All user, not server. Controller pose is local by definition -- the engine
// reads it from this machine's XR runtime, and usercmd_t carries no off-hand
// pose at all -- so there is nothing here another peer could meaningfully be
// told. Server cvars would also put every tuning tweak on the wire for no
// reason. See RS_Darkness's cvarinfo for what per-tic server cvar writes cost.

// ---------------------------------------------------------------- master --
// Off by default. Capture costs a handful of doubles per tic and matching
// costs a DTW pass per eligible template, and nobody who is not using gestures
// should pay either.
user bool  rsg_enabled = false;

// Prints mode open/close and every match with its confidence.
user bool  rsg_debug   = false;

// ----------------------------------------------------------------- entry --
// Gesture mode has to be entered deliberately, or every arm movement in a
// firefight is a candidate gesture. Entry is the OFF hand raised above head
// height -- no button, no grip. That is deliberate: the drawing (main) hand
// never touches an input anything else in this mod family reads, so a
// gesture cannot collide with grabbing, weapon fire, or a reload's own
// button and motion reads. Distinct enough not to happen by accident, and it
// needs no finger tracking, which this engine does not have (only two
// capacitive touch bits, not curl).
//
// Tics the pose must be held. 35 tics = 1 second.
user int   rsg_entry_hold = 18;

// Tics of gesture mode with nothing matching before it closes itself. Mode
// also closes on damage: being hit is exactly when you stopped meaning to cast.
user int   rsg_idle_exit  = 350;

// --------------------------------------------------------------- matching --
// A stroke is delimited by the off-hand pose (hold it through the sweep,
// drop it to match), not a sliding window -- this is a CAP on how long one
// hold may run, not the length matching happens over. Exists so an arm left
// raised cannot hold the ring buffer's history hostage forever; an ordinary
// stroke finishes on drop long before hitting it.
user int   rsg_window     = 70;

// Average per-step deviation, in map units, at which confidence reaches zero.
// Larger is more forgiving. This is the dial to turn when a gesture you are
// performing correctly will not fire.
user float rsg_tolerance  = 14.0;

// Confidence a match must beat, 0 to 1. Raise it if unrelated arm movement is
// firing gestures.
user float rsg_confidence = 0.35;

// A stroke whose furthest point is nearer than this to its start is a hand
// holding still, not a gesture. Without a floor here a motionless hand draws a
// tiny tight path that will cheerfully match anything.
user float rsg_min_extent = 8.0;

// -------------------------------------------------------------- recorded --
// One recorded gesture per slot, written by the Record menu -- never by hand.
// "v1|tolerance|x,y,z|..." is 32 body-relative points of the most typical take.
// Empty means unused. Anything that fails to parse is ignored whole rather
// than loaded half-broken, since a half-broken stroke would still match.
user string rsg_custom_1 = "";
user string rsg_custom_2 = "";
user string rsg_custom_3 = "";
user string rsg_custom_4 = "";

// ---------------------------------------------------------------- signals --
// POSES AND IMPULSES, which are the gestures that are not shapes: an open palm
// held, a hand held still, a thrust along the hand's own axis. See
// zscript/rsg_signals.zs for why these cannot be templates in the matcher --
// a pose has no path to normalise, and a hard thrust and a gentle one are the
// same shape.
//
// SEPARATE FROM rsg_enabled, and off by default like it. The QUERIES in
// RSG_Signals are static and read nothing but engine fields, so they keep
// working with this off; what this switch buys is the held-pose counters and
// the rsg_thrust event. A mod that asks the queries directly needs neither.
user bool  rsg_signals = false;

// HOW FAST A HAND MUST MOVE ALONG ITS OWN FORWARD AXIS, IN METRES A SECOND,
// before rsg_thrust is fired. Metres, not map units: map space is anisotropic
// (level.pixelstretch stretches the vertical), so a threshold in map units
// means a different real thrust depending which way the hand went. RSG_Signals
// converts to metric space before it measures, which is most of the reason
// that file exists. A thrust in Doom units is also a number nobody can
// picture.
user float rsg_thrust_mps = 2.0;

// ...AND HOW FRESH THAT PEAK MUST BE, in milliseconds. RS_HAND_PEAK is the
// fastest sample in a 250 ms ring, so without this a hand that thrust once and
// stopped keeps reporting that fast instant for a quarter of a second. 0 does
// not check.
user float rsg_thrust_age = 150.0;

// TICS BEFORE THE SAME HAND MAY FIRE rsg_thrust AGAIN. Not a cooldown for
// balance -- an anti-double-fire, because one human thrust spans several tics
// and passes the test on every one of them.
user int   rsg_thrust_repeat = 12;

// BELOW THIS, IN METRES A SECOND, A HAND COUNTS AS STILL -- which is a
// different question from a pose being held: a palm held open while the arm
// swings is open and is not still.
user float rsg_still_mps = 0.3;
