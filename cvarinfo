// RS_GESTURES -- CVars
//
// A gesture is a shape drawn in the air, matched against recorded templates by
// dynamic time warping so the same shape performed faster or slower still
// matches. Nothing here rewrites engine state; it reads the hand and head pose
// the engine already publishes every tic and decides whether the last second of
// motion looks like a template.
//
// All user, not server. Controller pose is local by definition -- the engine
// reads it from this machine's XR runtime, and usercmd_t carries no off-hand
// pose at all -- so there is nothing here another peer could meaningfully be
// told. Server cvars would also put every tuning tweak on the wire for no
// reason. See RS_Darkness's cvarinfo for what per-tic server cvar writes cost.

// ---------------------------------------------------------------- master --
// Off by default. Capture costs a handful of doubles per tic and matching
// costs a DTW pass per eligible template, and nobody who is not using gestures
// should pay either.
user bool  rsg_enabled = false;

// Prints mode open/close and every match with its confidence.
user bool  rsg_debug   = false;

// ----------------------------------------------------------------- entry --
// Gesture mode has to be entered deliberately, or every arm movement in a
// firefight is a candidate gesture. Entry is the OFF hand raised above head
// height -- no button, no grip. That is deliberate: the drawing (main) hand
// never touches an input anything else in this mod family reads, so a
// gesture cannot collide with grabbing, weapon fire, or a reload's own
// button and motion reads. Distinct enough not to happen by accident, and it
// needs no finger tracking, which this engine does not have (only two
// capacitive touch bits, not curl).
//
// Tics the pose must be held. 35 tics = 1 second.
user int   rsg_entry_hold = 18;

// Tics of gesture mode with nothing matching before it closes itself. Mode
// also closes on damage: being hit is exactly when you stopped meaning to cast.
user int   rsg_idle_exit  = 350;

// --------------------------------------------------------------- matching --
// A stroke is delimited by the off-hand pose (hold it through the sweep,
// drop it to match), not a sliding window -- this is a CAP on how long one
// hold may run, not the length matching happens over. Exists so an arm left
// raised cannot hold the ring buffer's history hostage forever; an ordinary
// stroke finishes on drop long before hitting it.
user int   rsg_window     = 70;

// Average per-step deviation, in map units, at which confidence reaches zero.
// Larger is more forgiving. This is the dial to turn when a gesture you are
// performing correctly will not fire.
user float rsg_tolerance  = 14.0;

// Confidence a match must beat, 0 to 1. Raise it if unrelated arm movement is
// firing gestures.
user float rsg_confidence = 0.35;

// A stroke whose furthest point is nearer than this to its start is a hand
// holding still, not a gesture. Without a floor here a motionless hand draws a
// tiny tight path that will cheerfully match anything.
user float rsg_min_extent = 8.0;

// -------------------------------------------------------------- recorded --
// One recorded gesture per slot, written by the Record menu -- never by hand.
// "v1|tolerance|x,y,z|..." is 32 body-relative points of the most typical take.
// Empty means unused. Anything that fails to parse is ignored whole rather
// than loaded half-broken, since a half-broken stroke would still match.
user string rsg_custom_1 = "";
user string rsg_custom_2 = "";
user string rsg_custom_3 = "";
user string rsg_custom_4 = "";

// ---------------------------------------------------------------- signals --
// POSES AND IMPULSES, which are the gestures that are not shapes: an open palm
// held, a hand held still, a thrust along the hand's own axis. See
// zscript/rsg_signals.zs for why these cannot be templates in the matcher --
// a pose has no path to normalise, and a hard thrust and a gentle one are the
// same shape.
//
// SEPARATE FROM rsg_enabled, and off by default like it. The QUERIES in
// RSG_Signals are static and read nothing but engine fields, so they keep
// working with this off; what this switch buys is the held-pose counters and
// the rsg_thrust event. A mod that asks the queries directly needs neither.
user bool  rsg_signals = false;

// HOW FAST A HAND MUST MOVE ALONG ITS OWN FORWARD AXIS, IN METRES A SECOND,
// before rsg_thrust is fired. Metres, not map units: map space is anisotropic
// (level.pixelstretch stretches the vertical), so a threshold in map units
// means a different real thrust depending which way the hand went. RSG_Signals
// converts to metric space before it measures, which is most of the reason
// that file exists. A thrust in Doom units is also a number nobody can
// picture.
user float rsg_thrust_mps = 2.0;

// ...AND HOW FRESH THAT PEAK MUST BE, in milliseconds. RS_HAND_PEAK is the
// fastest sample in a 250 ms ring, so without this a hand that thrust once and
// stopped keeps reporting that fast instant for a quarter of a second. 0 does
// not check.
user float rsg_thrust_age = 150.0;

// TICS BEFORE THE SAME HAND MAY FIRE rsg_thrust AGAIN. Not a cooldown for
// balance -- an anti-double-fire, because one human thrust spans several tics
// and passes the test on every one of them.
user int   rsg_thrust_repeat = 12;

// BELOW THIS, IN METRES A SECOND, A HAND COUNTS AS STILL -- which is a
// different question from a pose being held: a palm held open while the arm
// swings is open and is not still.
//
// SHARED WITH THE TWO-HAND PALMS POSE BELOW, deliberately. A second number for
// the same idea would drift from this one and the player would be handed two
// dials that both mean "how still is still". A hand in VR is never actually
// still, so this has to stay reachable: a player whose tremor sits above it can
// never hold a pose and has no way to find out why.
user float rsg_still_mps = 0.3;

// --------------------------------------------------------------- two hands --
// BOTH HANDS AT ONCE: swept down past the hips, thrown outward from the chest,
// or held out open and still. See zscript/rsg_pair.zs. These are a third kind
// again -- not a shape (there are two paths, and the matcher reads one ring) and
// not a pose (one hand's fields say nothing about the other hand's timing) --
// and all three fire the one event, rsg_pair, as an index and a magnitude.
//
// EVERYTHING HERE IS METRES, METRES A SECOND, OR REAL MILLISECONDS. Nothing is
// in map units, and nothing is in map tics. Map units are anisotropic, so a
// vertical threshold in them is about a fifth off a horizontal one, and these
// gestures are mostly vertical. Map tics stretch in slow motion, so a tolerance
// in them would mean a different real tolerance at every time scale. And
// everything vertical is measured from the HEADSET, so a short player, a tall
// player and a seated player perform the same gesture rather than three
// different ones.
//
// Off by default, and separately from both rsg_enabled and rsg_signals.
user bool  rsg_twohand = false;

// HOW FAR APART IN TIME TWO HANDS MAY BE AND STILL COUNT AS ONE GESTURE, in
// REAL milliseconds. THIS IS THE DIAL. Two hands swept down 400 ms apart are
// two movements; the same two 60 ms apart are one, and the number that divides
// them is a property of a particular person's arms -- which is why nobody can
// guess it and why it is here rather than in the code.
//
// It is compared between the two MOVEMENTS, not the two tics they were noticed
// on: HandPeakAgeMs gives each hand's fastest instant its own real time first.
// TURN IT UP when a two-hand gesture you are performing refuses to fire. Turn
// it DOWN when one hand plus a twitch of the other is firing one.
user float rsg_two_window_ms = 120.0;

// HOW FRESH EACH HAND'S FASTEST INSTANT MUST BE, in milliseconds. RS_HAND_PEAK
// is the fastest sample in a 250 ms ring, so without a cap a hand that moved
// once and stopped keeps reporting that instant for a quarter of a second.
// Looser than rsg_thrust_age because a two-handed heave is a slower and
// sloppier movement than a one-handed jab.
//
// 0 does not check, and the engine's own ring (vr_hand_window_ms, 250 ms) is
// then the oldest a peak can be, so that is what the staleness bound behind the
// pairing window falls back to. It has to fall back to something real: that
// bound is the only thing that stops two stamps pairing forever, and deriving
// it from this number alone made 0 mean "no two-hand sweep or throw ever fires
// again", which is not what switching a cap off should mean.
user float rsg_two_age = 180.0;

// REAL MILLISECONDS BEFORE THE SAME GESTURE MAY FIRE AGAIN. Not balance -- an
// anti-double-fire, because one human sweep passes the test on many consecutive
// tics. Real, not map, so it does not stretch in slow motion.
user float rsg_two_repeat_ms = 500.0;

// ---- both hands swept down past the hips ----------------------------------
// HOW FAST EACH HAND MUST BE GOING DOWNWARD, in metres a second.
user float rsg_two_down_mps = 2.0;

// ...AND HOW MUCH OF THAT HAND'S SPEED HAS TO BE THE DOWNWARD PART, 0 to 1. A
// speed threshold with no direction test fires on any fast arm movement, and a
// sword fight is nothing but fast arm movement. 0.5 is about 60 degrees off
// straight down. Raise it to demand a cleaner sweep.
user float rsg_two_down_frac = 0.5;

// HOW FAR BELOW THE HEADSET THE HIP LINE IS, in metres. A hand has to end up
// under it for a sweep to count. Standing eyes sit about 0.65 m above the hips
// and a seated player rather less, which is the whole reason this is measured
// from the head and not from the floor.
//
// ALSO THE FLOOR FOR THE PALMS POSE below, so a hand dangling open at your side
// is not half of a held pose. One number, so the two can never disagree about
// where a hip is.
user float rsg_two_hip_m = 0.60;

// ---- both hands thrown outward from the chest -----------------------------
// HOW FAST THE GAP BETWEEN THE HANDS MUST BE OPENING, in metres a second. It is
// the PAIR's number and each hand is asked for half of it: two hands going
// outward at half the threshold are separating at all of it. The gap opening is
// what tells this gesture from a two-handed shove -- two hands thrust FORWARD
// together are both leaving the chest and are not coming apart at all.
user float rsg_two_apart_mps = 2.0;

// HOW FAR BELOW THE HEADSET THE CHEST IS, in metres, and HOW NEAR IT A HAND
// MUST BE to be throwing from it. The radius is a ceiling, not a shell: the
// peak is up to rsg_two_age old, so by the time the throw is seen the hand has
// already left. What it really refuses is a hand thrown from the hip or from
// above the head.
user float rsg_two_chest_m = 0.40;
user float rsg_two_chest_r = 0.50;

// ---- both palms held out --------------------------------------------------
// HOW FAR IN FRONT OF THE HEADSET A PALM MUST BE, in metres, measured in the
// body's own frame so that it means "in front of you" and not "north". A hand
// resting open at your side is not a barrier.
user float rsg_two_front_m = 0.25;

// HOW LONG BOTH PALMS MUST BE OUT, OPEN AND STILL, in REAL milliseconds. The
// clock starts when the SECOND palm arrives, so the first hand getting there
// early earns nothing. The event is the onset only; a power that lasts while
// the palms are up follows RSG_TwoHand.PalmsOutSeconds() rather than waiting
// for a second event that is never coming.
user float rsg_two_hold_ms = 400.0;
